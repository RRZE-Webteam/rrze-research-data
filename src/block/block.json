{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rrze/research-data",
  "version": "0.0.1",
  "title": "Research Data",
  "category": "rrze",
  "icon": "admin-page",
  "description": "Displays publications from research platforms.",
  "supports": {
    "html": false
  },
  "attributes": {
    "isInitialSetup": {
      "type": "boolean",
      "default": true
    },
    "authorId": {
      "type": "string",
      "default": ""
    },
    "source": {
      "type": "string",
      "default": "orcid"
    },
    "limit": {
      "type": "number",
      "default": 15
    },
    "yearFrom": {
      "type": "number",
      "default": 0
    },
    "yearTo": {
      "type": "number",
      "default": 0
    },
    "type": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "groupBy": {
      "type": "string",
      "default": ""
    },
    "citationStyle": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "rrze-research-data",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style.css",
  "example": {
    "attributes": {
      "isInitialSetup": false
    }
  }
}
